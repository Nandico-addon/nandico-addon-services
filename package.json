{
  "name": "nandico-addon-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend-only PACS outbox receiver with code-based group routing",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "test:msgclub": "node scripts/test-msgclub-simulation.js",
    "demo": "node --env-file-if-exists=.env scripts/send-event.js",
    "jobs": "node --env-file-if-exists=.env scripts/jobs.js"
  }
}
