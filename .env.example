# Incoming PACS credentials: match outbox.addon.password and outbox.addon.secret.
NODE_ENV=development
HOST=127.0.0.1
PORT=3999
BASIC_USER=nandico
BASIC_PASSWORD=example-password
HMAC_SECRET=example-secret

# Separate from the previous application's archived data.
DATA_DIR=./data/backend
LOG_DIR=./logs
LOG_LEVEL=info

# API keys are outbound provider credentials, separate from incoming PACS auth.

# Group 48991 provider credentials. Keep AUTH_KEY separate from the URL so it
# cannot be copied into source, saved group configuration or application logs.
# Uses the account's approved templates with its registered WhatsApp number.
GROUP_48991_ICLOUDSMS_URL=https://msg.icloudsms.com/rest/services/sendSMS/v2/sendtemplate
GROUP_48991_ICLOUDSMS_AUTH_KEY=
GROUP_48991_ICLOUDSMS_SENDER_ID=919828298283

# Local Postman simulation only, with fake provider credentials. Leave unset
# for real sending; production startup rejects this override.
# ICLOUDSMS_SIMULATION_URL=http://127.0.0.1:4900/icloudsms/rest/services/sendSMS/v2/sendtemplate
