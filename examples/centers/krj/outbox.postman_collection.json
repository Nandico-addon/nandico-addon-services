{
  "info": {
    "name": "KRJ PACS outbox \u2014 upload and sign-off",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Signed PACS events for KRJ group 27919. originReferenceId maps to HIMS OrderId; payload.ftpPath maps to HIMS ZipFilePath. SIGNOFF downloads reportPdfLink and uploads PDF bytes. Skipped until allowHimsSend=true."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{basicUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{basicPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://addon.nandico.in"
    },
    {
      "key": "basicUser",
      "value": "nandico"
    },
    {
      "key": "basicPassword",
      "value": ""
    },
    {
      "key": "hmacSecret",
      "value": ""
    },
    {
      "key": "allowHimsSend",
      "value": "false"
    },
    {
      "key": "groupId",
      "value": "27919"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "ftpPath",
      "value": ""
    },
    {
      "key": "reportPdfLink",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (String(pm.variables.get('allowHimsSend')) !== 'true') {",
          "  pm.execution.skipRequest();",
          "} else {",
          "  const { Buffer } = require('buffer');",
          "  const password = pm.variables.get('basicPassword');",
          "  const secret = pm.variables.get('hmacSecret');",
          "  if (!password || !secret) throw new Error('Set incoming PACS basicPassword and hmacSecret');",
          "  const groupId = Number(pm.variables.get('groupId'));",
          "  const base = new URL(pm.variables.get('baseUrl'));",
          "  if (!Number.isSafeInteger(groupId) || groupId < 0) throw new Error('Set a valid groupId');",
          "  if (groupId === 0 && !['127.0.0.1', 'localhost', '[::1]'].includes(base.hostname)) throw new Error('Placeholder group 0 is local only');",
          "  const orderId = String(pm.variables.get('orderId') || '');",
          "  if (!orderId.trim()) throw new Error('Set the controlled HIMS orderId (accession reference)');",
          "  const type = pm.info.requestName;",
          "  const now = new Date(Date.now() + 330 * 60000).toISOString().slice(0, 19).replace('T', ' ');",
          "  const payload = { reportStatusId: 987654, originReferenceId: orderId, hasReport: type === 'SIGNOFF', reworked: false, urgent: false, critical: false };",
          "  if (type === 'STUDY_UPLOADED') {",
          "    const ftpPath = String(pm.variables.get('ftpPath') || '');",
          "    if (!ftpPath.trim()) throw new Error('Set the PACS study ftpPath for this test');",
          "    Object.assign(payload, { ftpPath, uploadCount: 1, imageCount: 120, seriesCount: 3, firstUploadCompletedAt: now, lastUploadCompletedAt: now });",
          "  } else {",
          "    const reportPdfLink = String(pm.variables.get('reportPdfLink') || '');",
          "    if (!reportPdfLink.trim()) throw new Error('Set a downloadable PDF URL allowed by HIMS_KRJ_REPORT_HOSTS');",
          "    Object.assign(payload, { reportPdfLink, reportFileName: 'test-report.pdf' });",
          "  }",
          "  const raw = JSON.stringify({ id: Date.now(), type, groupId, reportStatusId: 987654, createdAt: now, payload });",
          "  const timestamp = String(Math.floor(Date.now() / 1000));",
          "  const key = await crypto.subtle.importKey('raw', Buffer.from(secret, 'utf8'), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);",
          "  const digest = await crypto.subtle.sign('HMAC', key, Buffer.from(timestamp + '.' + raw, 'utf8'));",
          "  pm.variables.set('eventBody', raw);",
          "  pm.variables.set('timestamp', timestamp);",
          "  pm.variables.set('signature', 'sha256=' + Buffer.from(digest).toString('hex'));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Receiver durably acknowledged the event', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.equal('accepted'); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "STUDY_UPLOADED",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/outbox",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Timestamp",
            "value": "{{timestamp}}"
          },
          {
            "key": "X-Signature",
            "value": "{{signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{eventBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "SIGNOFF",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/outbox",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Timestamp",
            "value": "{{timestamp}}"
          },
          {
            "key": "X-Signature",
            "value": "{{signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{eventBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
